DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot

# docker-compose postgres service
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
POSTGRES_PORT=5432

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

OLLAMA_AGENT_MODEL=qwen3.5:2b-mlx
OLLAMA_SMALL_AGENT_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT_SECONDS=30

# How many tokens the model can read at once (prompt + reply together).
# Worth setting: Ollama's own default is 4096 no matter what the model supports,
# and it silently cuts the start off longer prompts, system prompt included.
# Bigger reserves more memory up front.
OLLAMA_NUM_CTX=16384

AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_CONCURRENCY=2
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_TITLE_TIMEOUT_SECONDS=15
AGENT_TITLE_MAX_TOKENS=24
AGENT_RECURSION_LIMIT=8

# Short-term memory
#
# Every budget here is in TOKENS, not message counts. Counting messages looks
# simpler but breaks: twenty short messages fit easily while twenty pasted
# documents can be twenty times the whole context window.
#
# Total budget for what we send the model: summary + replayed messages + the new
# message together. Must leave room for the reply inside OLLAMA_NUM_CTX, and must
# be large enough for one maximum-length message on its own. Startup checks both.
# Here 10000 + 4096 output = 14096, inside the 16384 window.
AGENT_HISTORY_MAX_TOKENS=10000
# Row cap on the history query, on top of the token budget. Stops the query
# loading thousands of rows just to throw most of them away.
AGENT_HISTORY_MAX_MESSAGES=40

# Summarizing older messages
# Off => messages are simply forgotten once they no longer fit the budget.
SUMMARY_ENABLED=true
# Unsummarized tokens needed before a summary is written or refreshed.
#
# Must stay below AGENT_HISTORY_MAX_TOKENS - SUMMARY_MAX_TOKENS (here 9488).
# Summarizing only preserves messages while they still fit the prompt; trigger
# too late and they are dropped for space first, and nothing can recover them.
SUMMARY_TRIGGER_TOKENS=4000
# Newest tokens never folded into the summary, because follow-up questions refer
# to those messages ("that one", "make it 5").
SUMMARY_KEEP_RECENT_TOKENS=1500
# Length limit for the summary. It is sent with every later request, so an
# unlimited one would eat the space it is meant to save.
SUMMARY_MAX_TOKENS=512

LOG_LEVEL=INFO
SQL_ECHO=false
