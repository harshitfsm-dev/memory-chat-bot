DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot

# docker-compose postgres service
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
POSTGRES_PORT=5432

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Must support tools, and must be able to turn thinking off. A reasoning-only
# model (e.g. deepseek-r1) ignores that and returns its answer in the thinking
# field, leaving content empty -- which silently produces blank summaries.
OLLAMA_AGENT_MODEL=gemma4:12b-mlx
# Thinking delays the first streamed token and eats AGENT_MAX_OUTPUT_TOKENS.
OLLAMA_AGENT_REASONING=false
OLLAMA_SMALL_AGENT_MODEL=qwen3.5:2b-mlx
# Must support JSON-schema structured output, which several local models do not.
# Measured with scripts/eval_memory_extraction.py: llama3.1:8b 51/57, llama3.2:3b
# 41/57, deepseek-r1:14b 8/19 and 13x slower, gemma4:12b-mlx and qwen3.6:27b-mlx
# return nothing parseable. Bigger is not monotonically better.
OLLAMA_MEMORY_MODEL=llama3.1:8b
# Must produce 768-dimensional vectors to match user_memories.embedding. This
# model is natively 2560-dimensional with Matryoshka support, so Ollama returns
# a usable 768-dimensional prefix on request.
#
# Not retroactive: episode retrieval filters on embedding_model, so episodes
# embedded by a previous model stop being retrieved. Pinned facts are unaffected.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT_SECONDS=30

# Long-term memory extraction and storage
MEMORY_ENABLED=true
# Applied separately to extraction and batch embedding calls.
MEMORY_TIMEOUT_SECONDS=45
MEMORY_EXTRACTION_MAX_TOKENS=768
MEMORY_MAX_ITEMS_PER_TURN=6
# Candidates below this confidence are discarded before embedding/storage.
MEMORY_MIN_CONFIDENCE=0.7

# Long-term memory retrieval and prompt injection
MEMORY_RETRIEVAL_ENABLED=true
# Hard cosine gate applied in SQL before anything is ranked.
#
# Tied to OLLAMA_EMBEDDING_MODEL: cosine scores are not comparable across
# embedding models, so re-measure this whenever that changes. With
# qwen3-embedding:4b at 768 dimensions, relevant pairs score 0.61-0.78 and
# unrelated pairs top out at 0.58. The old 0.70 came from nomic-embed-text and
# dropped most genuinely relevant episodes.
MEMORY_RETRIEVAL_MIN_SIMILARITY=0.6
# How many episodes may reach the prompt after ranking.
MEMORY_RETRIEVAL_MAX_EPISODES=3
# How many notes may reach the prompt after ranking. A separate cap, not a shared
# pool: notes and episodes are ranked on the same scale and then spend the token
# budget in score order, but each kind gets its own slots first so one talkative
# tier cannot starve the other.
MEMORY_RETRIEVAL_MAX_NOTES=3
# Candidates fetched per prompt slot before ranking. The cosine gate finds what
# is similar; the weights below decide what is worth sending. Those disagree, so
# the query has to return more rows than the prompt will use.
MEMORY_RETRIEVAL_CANDIDATE_FACTOR=5
# Relative weights of the episode ranking signals. Only the ratios matter; they
# are normalized. Similarity leads because an irrelevant memory is worse than a
# missing one, and the other two break the ties similarity leaves behind.
MEMORY_SCORE_SIMILARITY_WEIGHT=0.6
MEMORY_SCORE_IMPORTANCE_WEIGHT=0.25
MEMORY_SCORE_RECENCY_WEIGHT=0.15
# Age at which the recency signal halves. Affects ranking only: nothing is
# deleted or hidden, an old memory just has to be more relevant to win a slot.
MEMORY_RECENCY_HALF_LIFE_DAYS=30
# Strict sub-budget inside AGENT_HISTORY_MAX_TOKENS; facts consume it first.
MEMORY_RETRIEVAL_MAX_TOKENS=384

# Free-text notes
#
# Notes are the only memory tier whose wording comes from the conversation rather
# than from a fixed vocabulary, so these two settings bound that exposure.
#
# Longest note stored. Longer ones are rejected, never truncated: clipping a
# sentence mid-way can invert its meaning, and a note the user can restate is a
# smaller loss than a stored sentence that says the opposite of what happened.
MEMORY_NOTE_MAX_CHARS=200
# How alike two notes in one category must be to count as the same thing, so a
# re-mention refreshes the existing note instead of adding a paraphrase of it.
#
# Higher than MEMORY_RETRIEVAL_MIN_SIMILARITY on purpose. Retrieval asks "is this
# related?", where a false positive wastes one prompt slot. This asks "is this the
# same?", where a false positive overwrites a memory nobody asked to replace.
MEMORY_NOTE_DEDUPE_SIMILARITY=0.9
# How long a dated note stays usable after its event has passed. Not zero: right
# after a trip is exactly when someone asks how it went. Only applies when a date
# was actually extracted; undated notes use their category's lifetime.
MEMORY_EVENT_GRACE_DAYS=7

# Consolidation: periodic tidying of a user's notes
#
# Notes are the only tier without a natural bound — facts are limited by the key
# list and episodes by the closed vocabulary, but anything can be a note. This runs
# on the post-turn path (no scheduler), guarded by an advisory lock so two
# concurrent turns cannot tidy the same user twice.
MEMORY_CONSOLIDATION_ENABLED=true
# Active notes a user needs before it runs at all. A handful cannot be untidy enough.
MEMORY_CONSOLIDATION_TRIGGER_NOTES=20
# How alike two notes must be before merging is *considered*. Similarity alone
# cannot decide identity here: measured on real stored sentences, paraphrases score
# 0.93-0.97 while pairs that merely share a shape score 0.81-0.98 — the bands
# overlap, and the highest-scoring pair of all (0.979) is "the launch is next week"
# against "next month". A candidate pair must also agree on dates, numbers, proper
# nouns and period words before it is merged. Set at the bottom of the paraphrase
# range, so it errs towards leaving duplicates: an unmerged duplicate wastes a row,
# a wrong merge loses a memory.
MEMORY_CONSOLIDATION_SIMILARITY=0.93
# Hard ceiling on active notes per user. Beyond it the least valuable are retired,
# by importance then recency.
MEMORY_MAX_ACTIVE_NOTES=100

# How many tokens the model can read at once (prompt + reply together).
# Worth setting: Ollama's own default is 4096 no matter what the model supports,
# and it silently cuts the start off longer prompts, system prompt included.
# Bigger reserves more memory up front.
OLLAMA_NUM_CTX=16384

AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_CONCURRENCY=2
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_TITLE_TIMEOUT_SECONDS=15
AGENT_TITLE_MAX_TOKENS=24
AGENT_RECURSION_LIMIT=8

# Short-term memory
#
# Every budget here is in TOKENS, not message counts. Counting messages looks
# simpler but breaks: twenty short messages fit easily while twenty pasted
# documents can be twenty times the whole context window.
#
# Total budget for what we send the model: summary + replayed messages + the new
# message together. Must leave room for the reply inside OLLAMA_NUM_CTX, and must
# be large enough for one maximum-length message on its own. Startup checks both.
# Here 10000 + 4096 output = 14096, inside the 16384 window.
AGENT_HISTORY_MAX_TOKENS=10000
# Row cap on the history query, on top of the token budget. Stops the query
# loading thousands of rows just to throw most of them away.
AGENT_HISTORY_MAX_MESSAGES=40

# Summarizing older messages
# Off => messages are simply forgotten once they no longer fit the budget.
SUMMARY_ENABLED=true
# Unsummarized tokens needed before a summary is written or refreshed.
#
# Must stay below AGENT_HISTORY_MAX_TOKENS - SUMMARY_MAX_TOKENS (here 9488).
# Summarizing only preserves messages while they still fit the prompt; trigger
# too late and they are dropped for space first, and nothing can recover them.
SUMMARY_TRIGGER_TOKENS=4000
# Newest tokens never folded into the summary, because follow-up questions refer
# to those messages ("that one", "make it 5").
SUMMARY_KEEP_RECENT_TOKENS=1500
# Length limit for the summary. It is sent with every later request, so an
# unlimited one would eat the space it is meant to save.
SUMMARY_MAX_TOKENS=512

LOG_LEVEL=INFO
SQL_ECHO=false
