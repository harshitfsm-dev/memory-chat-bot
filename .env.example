DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot

# docker-compose postgres service
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
POSTGRES_PORT=5432

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

OLLAMA_AGENT_MODEL=qwen3.5:2b-mlx
OLLAMA_SMALL_AGENT_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT_SECONDS=30

# How many tokens the model can read at once (prompt + reply together).
# Worth setting: Ollama's own default is 4096 no matter what the model supports,
# and it silently cuts the start off longer prompts, system prompt included.
# Bigger reserves more memory up front.
OLLAMA_NUM_CTX=16384

AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_CONCURRENCY=2
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_TITLE_TIMEOUT_SECONDS=15
AGENT_TITLE_MAX_TOKENS=24
AGENT_RECURSION_LIMIT=8

# Short-term memory
# How many recent messages get replayed to the model. The main memory dial:
# higher remembers more but costs more per request.
AGENT_HISTORY_MAX_MESSAGES=20
# Safety net on prompt size, enforced by TrimHistoryMiddleware.
AGENT_HISTORY_MAX_TOKENS=4000

# Summarizing older messages
# Off => messages are simply forgotten once they fall outside the replay window.
SUMMARY_ENABLED=true
# Unsummarized messages needed before a summary is written or refreshed. Keep it
# at or below AGENT_HISTORY_MAX_MESSAGES, or messages would be forgotten before
# anything summarizes them. Startup checks this.
SUMMARY_TRIGGER_MESSAGES=12
# Newest messages never folded into the summary, because follow-up questions
# refer to them ("that one", "make it 5").
SUMMARY_KEEP_RECENT_MESSAGES=6
# Length limit for the summary. It is sent with every later request, so an
# unlimited one would eat the space it is meant to save.
SUMMARY_MAX_TOKENS=512

LOG_LEVEL=INFO
SQL_ECHO=false
