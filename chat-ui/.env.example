# Base URL the app uses for backend API calls.
# Defaults to the same-origin "/api" prefix, which the Vite dev server proxies
# to the backend. Set this to an absolute URL when the API is on another origin
# (e.g. a deployed environment).
# VITE_API_BASE_URL=/api

# Backend origin the Vite dev server proxies "/api" requests to (dev only).
# Defaults to http://127.0.0.1:8000 (FastAPI's default).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
